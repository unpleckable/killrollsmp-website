# ============================================================
#  Clean URLs  (Apache / .htaccess)
#
#    /                -> 301 -> /home   (index.html is "home")
#    /index.html      -> 301 -> /home
#    /home            -> serves index.html
#    /teams.html      -> 301 -> /teams
#    /teams           -> serves teams.html
#
#  The .html files stay on disk; only the URLs change.
# ============================================================

<IfModule mod_rewrite.c>

  RewriteEngine On

  # If the site is NOT at the domain root, point this at the folder, e.g.
  #   RewriteBase /killrollsmp-website/
  RewriteBase /

  # Stop Apache from auto-mapping /teams to teams.html on its own, so our
  # rules below stay in control. If this line causes a 500 error on your
  # host (Options not allowed), just delete it.
  Options -MultiViews


  # ----------------------------------------------------------
  #  1. index.html is called "home" in the URL
  # ----------------------------------------------------------

  # /home  and  /home/  ->  index.html
  RewriteRule ^home/?$ index.html [L]

  # /index.html  and  /index  ->  /home
  RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[\s?] [NC]
  RewriteRule ^ /home [R=301,L]

  # Bare domain root  ->  /home
  RewriteRule ^$ /home [R=301,L]


  # ----------------------------------------------------------
  #  2. Hide .html on every other page
  # ----------------------------------------------------------

  # /teams.html  ->  /teams   (works for subfolders too)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /teams/  ->  /teams   (one canonical URL shape, only if teams.html exists)
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ /%1 [R=301,L]

  # /teams  ->  teams.html   (internal rewrite, URL stays clean)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

</IfModule>
